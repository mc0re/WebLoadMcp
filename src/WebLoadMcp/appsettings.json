{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting": "Warning"
    }
  },
  "WebLoad": {
    "BaseUrl": "https://example.com/",
    "TimeoutSeconds": 30,
    "UserAgent": "WebLoadMcp/1.0",
    "List": {
      "ItemSelector": ".item",
      "Fields": {
        "year": { "Selector": ".year" },
        "title": { "Selector": ".title" },
        "link": { "Selector": "a[href]", "Attribute": "href" }
      }
    },
    "Detail": {
      "Fields": {
        "title": { "Selector": "h1" },
        "country": { "Selector": ".country" },
        "description": { "Selector": ".description" },
        "genres": { "Selector": ".genres li", "Multiple": true },
        "audio": { "Selector": ".audio li", "Multiple": true },
        "subtitles": { "Selector": ".subtitles li", "Multiple": true },
        "size": { "Selector": ".size" },
        "reference": { "Selector": "a.download[href]", "Attribute": "href" }
      }
    }
  },
  "Ready": {
    "Country": "",
    "GeoIpUrl": "https://ipinfo.io/json",
    "CountryProperty": "country",
    "TimeoutSeconds": 10
  }
}
