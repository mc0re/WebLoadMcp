{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting": "Warning"
    }
  },
  "WebLoad": {
    "BaseUrl": "https://rutor.is/",
    "TimeoutSeconds": 30,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36",
    "List": {
      "ItemSelector": "#index > table tr.gai, #index > table tr.tum",
      "Fields": {
        "year": { "Selector": "a[href*='/torrent/']", "Pattern": "\\((\\d{4})" },
        "title": { "Selector": "a[href*='/torrent/']" },
        "link": { "Selector": "a[href*='/torrent/']", "Attribute": "href" }
      }
    },
    "Detail": {
      "Fields": {
        "title": { "Selector": "h1" },
        "country": { "Selector": "#details b", "Label": "Страна" },
        "description": { "Selector": "#details b", "Label": "О фильме" },
        "genres": { "Selector": "#details b", "Label": "Жанр", "Separator": "," },
        "audio": { "Selector": "#details b", "Label": "Аудио", "Multiple": true },
        "subtitles": { "Selector": "#details b", "Label": "Субтитры", "Separator": "," },
        "size": { "Selector": "#details td.header", "Label": "Размер", "Pattern": "^[\\d.,]+\\s*[KMGT]?B" },
        "reference": { "Selector": "#download a[href^='magnet:']", "Attribute": "href" }
      }
    }
  },
  "Ready": {
    "Country": "",
    "GeoIpUrl": "https://ipinfo.io/json",
    "CountryProperty": "country",
    "TimeoutSeconds": 10
  }
}
