{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting": "Warning"
    }
  },
  "WebLoad": {
    "BaseUrl": "https://example.com/",
    "TimeoutSeconds": 30,
    "UserAgent": "WebLoadMcp/1.0",
    "List": {
      "ItemSelector": ".item",
      "Fields": {
        "year": { "Selector": ".year" },
        "title": { "Selector": ".title" },
        "link": { "Selector": "a[href]", "Attribute": "href" }
      }
    },
    "Detail": {
      "Fields": {
        "title": { "Selector": "h1" },
        "content": { "Selector": "main, article, body" },
        "images": { "Selector": "img[src]", "Attribute": "src", "Multiple": true }
      }
    }
  },
  "Ready": {
    "Country": "",
    "GeoIpUrl": "https://ipinfo.io/json",
    "CountryProperty": "country",
    "TimeoutSeconds": 10
  }
}
